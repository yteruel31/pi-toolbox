{
  "name": "pi-toolbox",
  "version": "1.7.1",
  "private": true,
  "type": "module",
  "description": "Pi extensions including an MCP client and capability gateway.",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent"
  ],
  "license": "MIT",
  "pi": {
    "extensions": [
      "./packages/claude-marketplace/src/index.ts",
      "./packages/claude-context/src/index.ts",
      "./packages/claude-rules/src/index.ts",
      "./packages/pi-learning/src/index.ts",
      "./packages/session-title/src/index.ts",
      "./packages/mcp/src/index.ts"
    ],
    "themes": [
      "./themes/*.json"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.81.1",
    "@earendil-works/pi-coding-agent": "^0.81.1",
    "@earendil-works/pi-tui": "^0.81.1",
    "@semantic-release/git": "11.0.1",
    "@tailwindcss/cli": "4.3.3",
    "@types/node": "^22.19.1",
    "esbuild": "0.28.1",
    "semantic-release": "25.0.8",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "tsx": "^4.21.0",
    "zod": "^4.4.3"
  }
}
