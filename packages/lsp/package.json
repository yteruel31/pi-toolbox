{
  "name": "@yteruel31/pi-lsp",
  "version": "0.0.0",
  "type": "module",
  "description": "Language-server diagnostics, navigation, and safe semantic renames for Pi.",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "lsp",
    "language-server",
    "diagnostics"
  ],
  "author": "Yoann TERUEL <yoann@gigapay.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yteruel31/pi-toolbox.git",
    "directory": "packages/lsp"
  },
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "bin": {
    "pi-lsp-sonar-install": "./src/sonar-install.mjs"
  },
  "files": [
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "tsc --noEmit && tsx --test test/*.test.ts test/*.test.mjs",
    "test": "tsx --test test/*.test.ts test/*.test.mjs",
    "pack:dry": "npm pack --dry-run"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": { "optional": true },
    "@earendil-works/pi-coding-agent": { "optional": true },
    "@earendil-works/pi-tui": { "optional": true },
    "typebox": { "optional": true }
  },
  "dependencies": {
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.84.2",
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@earendil-works/pi-tui": "0.84.2",
    "@types/node": "^22.19.1",
    "tsx": "^4.21.0",
    "typebox": "^1.3.15",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
