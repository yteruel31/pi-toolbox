{
  "name": "pi-claude-context",
  "version": "0.1.0",
  "type": "module",
  "description": "Pi extension that injects descendant Claude Code CLAUDE.md context files into agent sessions.",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "claude",
    "claude-code",
    "context"
  ],
  "author": "Yoann Teruel",
  "license": "MIT",
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "files": [
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "pack:dry": "npm pack --dry-run"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.80.2",
    "@types/node": "^22.19.1",
    "typescript": "^5.9.3"
  }
}
