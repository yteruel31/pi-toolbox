{
  "name": "@yteruel31/pi-diagram",
  "version": "0.0.0",
  "type": "module",
  "description": "Create, render, and securely host live diagrams from Pi.",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "diagram",
    "svg",
    "flowchart"
  ],
  "author": "Yoann TERUEL <yoann@gigapay.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yteruel31/pi-toolbox.git",
    "directory": "packages/diagram"
  },
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "files": [
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "check": "tsc --noEmit && node --check src/server/viewer-client.js && tsx --test test/*.test.ts",
    "test": "tsx --test test/*.test.ts",
    "pack:dry": "npm pack --dry-run"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@resvg/resvg-js": "^2.6.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": { "optional": true },
    "@earendil-works/pi-coding-agent": { "optional": true },
    "@earendil-works/pi-tui": { "optional": true },
    "typebox": { "optional": true }
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.84.2",
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@earendil-works/pi-tui": "0.84.2",
    "@types/node": "^22.19.1",
    "tsx": "^4.21.0",
    "typebox": "^1.3.15",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
