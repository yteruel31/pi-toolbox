{
  "name": "@yteruel31/pi-guardrails",
  "version": "0.1.0",
  "type": "module",
  "description": "Policy-first mistake prevention for Pi tools and in-process Pi subagents.",
  "keywords": ["pi-package", "pi", "pi-coding-agent", "guardrails"],
  "author": "Yoann TERUEL <yoann@gigapay.com>",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/yteruel31/pi-toolbox.git", "directory": "packages/guardrails" },
  "publishConfig": { "access": "public" },
  "pi": { "extensions": ["./src/index.ts"] },
  "files": ["src", "README.md", "LICENSE"],
  "scripts": {
    "check": "tsc --noEmit && node --import tsx --test test/*.test.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "pack:dry": "npm pack --dry-run"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "dependencies": { "@typesafe-ai/sdk": "^0.6.0", "@yteruel31/pi-operation-hooks": "^0.1.0", "zod": "^4.4.3" },
  "devDependencies": { "@types/node": "^22.19.1", "typescript": "^5.9.3", "tsx": "^4.21.0" },
  "engines": { "node": ">=22.19.0" }
}
