{
  "name": "@yteruel31/pi-subagents",
  "version": "0.1.0",
  "description": "Autonomous background subagents for Pi: spawn, inspect, cancel, and collect bounded background runs on Pi or Claude Code harnesses. Child harnesses run with normal host permissions; the Claude harness bypasses permission prompts.",
  "license": "MIT",
  "author": "Yoann TERUEL <yoann@gigapay.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yteruel31/pi-toolbox.git",
    "directory": "packages/subagents"
  },
  "bugs": "https://github.com/yteruel31/pi-toolbox/issues",
  "homepage": "https://github.com/yteruel31/pi-toolbox/tree/main/packages/subagents#readme",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md",
    "ARCHITECTURE.md",
    "CLEANROOM.md"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "pi",
    "pi-coding-agent",
    "pi-extension",
    "subagents",
    "claude-agent-sdk",
    "background-agents"
  ],
  "pi": {
    "extensions": [
      "./src/extension.ts"
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit && vitest run",
    "test": "vitest run",
    "test:watch": "vitest",
    "pack:dry": "npm pack --dry-run",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.1"
  },
  "optionalDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.259"
  },
  "devDependencies": {
    "@types/node": "^22.19.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.84.2",
    "@earendil-works/pi-tui": "^0.84.2",
    "typebox": "^1.3.15"
  }
}
