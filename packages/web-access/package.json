{
  "name": "@yteruel31/pi-web-access",
  "version": "0.0.0",
  "type": "module",
  "description": "Bounded web access and recoverable native deep research for Pi.",
  "keywords": ["pi-package", "pi", "pi-coding-agent", "web-search"],
  "author": "Yoann TERUEL <yoann@gigapay.com>",
  "license": "MIT",
  "repository": {"type": "git", "url": "git+https://github.com/yteruel31/pi-toolbox.git", "directory": "packages/web-access"},
  "publishConfig": {"access": "public"},
  "pi": {"extensions": ["./src/index.ts"]},
  "files": ["src", "README.md", "CHANGELOG.md", "LICENSE", "THIRD_PARTY_NOTICES.md"],
  "scripts": {
    "check": "tsc --noEmit && tsx --test test/*.test.ts",
    "test": "tsx --test test/*.test.ts",
    "build": "tsc --noEmit && esbuild src/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/index.js",
    "pack:dry": "npm pack --dry-run"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "ipaddr.js": "^2.2.0",
    "linkedom": "^0.18.12",
    "playwright-core": "^1.58.2",
    "turndown": "^7.2.0",
    "unpdf": "^1.4.0"
  },
  "peerDependencies": {"@earendil-works/pi-ai": "*", "@earendil-works/pi-coding-agent": "*", "@earendil-works/pi-tui": "*", "typebox": "*"},
  "peerDependenciesMeta": {"@earendil-works/pi-ai": {"optional": true}, "@earendil-works/pi-coding-agent": {"optional": true}, "@earendil-works/pi-tui": {"optional": true}, "typebox": {"optional": true}},
  "devDependencies": {"@types/turndown": "^5.0.5", "@types/node": "^22.19.1", "tsx": "^4.21.0", "typebox": "^1.3.15", "typescript": "^5.9.3", "esbuild": "0.28.1", "@earendil-works/pi-ai": "0.84.2", "@earendil-works/pi-coding-agent": "0.84.2", "@earendil-works/pi-tui": "0.84.2"},
  "engines": {"node": ">=22.19.0"}
}
