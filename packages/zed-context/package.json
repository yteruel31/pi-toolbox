{
  "name": "@yteruel31/pi-zed-context",
  "version": "0.2.0",
  "type": "module",
  "description": "Automatically attach Zed editor selections to Pi prompts with an explicit selected-line count.",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "zed",
    "ide",
    "selection"
  ],
  "author": "Yoann TERUEL <yoann@gigapay.com>",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/yteruel31/pi-toolbox.git", "directory": "packages/zed-context" },
  "publishConfig": { "access": "public" },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "bin": {
    "pi-zed-context": "./bin/pi-zed-context.mjs"
  },
  "files": [
    "bin",
    "src",
    "scripts/test-zed-context.mjs",
    "zed-extension",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "tsc --noEmit && node scripts/test-zed-context.mjs",
    "pack:dry": "npm pack --dry-run"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@types/node": "^22.19.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
